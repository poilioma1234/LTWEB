@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-layout">
    <section class="auth-card">
        <h1>Đăng nhập</h1>
        <p class="text-muted">Dùng tài khoản Admin hoặc Member để trải nghiệm phân quyền.</p>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label">Email hoặc UserName</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMe" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    Ghi nhớ đăng nhập
                </label>
            </div>
            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Đăng nhập</button>
            <div class="mt-3">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký tài khoản mới</a>
            </div>
        </form>
    </section>
    <aside class="demo-card">
        <strong>Tài khoản demo</strong>
        <span>Admin: admin@gmail.com / 123456</span>
        <span>Member: member@gmail.com / 123456</span>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
