@model IEnumerable<test.Models.Category>

@{
    ViewData["Title"] = "Quản lý category";
}

<h1>Quản lý category</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm category</a>
    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Trang quản trị</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Tên category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
