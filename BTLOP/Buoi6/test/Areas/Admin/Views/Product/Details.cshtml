@model test.Models.Product

@{
    ViewData["Title"] = "Chi tiết product";
    var oldPrice = Model.Price * 1.12m;
}

<div class="bg-white rounded-3 shadow-sm p-3 mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-2">
            <li class="breadcrumb-item"><a class="link-danger text-decoration-none" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a></li>
            <li class="breadcrumb-item"><a class="link-danger text-decoration-none" asp-action="Index">Product</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h1 class="h3 fw-bold mb-0">Chi tiết product</h1>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="bi bi-pencil-square"></i>
                Sửa
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Trở lại
            </a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded-3 border" alt="@Model.Name" />
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <span class="badge text-bg-danger mb-2">@Model.Category?.Name</span>
                <h2 class="h3 fw-bold">@Model.Name</h2>

                <div class="d-flex align-items-end gap-3 my-3">
                    <div class="display-6 fw-bold text-danger">@Model.Price.ToString("N0")đ</div>
                    <div class="text-secondary text-decoration-line-through">@oldPrice.ToString("N0")đ</div>
                </div>

                <div class="alert alert-danger">
                    <strong>Ưu đãi hiển thị:</strong> Bảo hành 1 đổi 1 trong 90 ngày, hỗ trợ phần mềm trọn đời.
                </div>

                <p class="text-secondary">@Model.Description</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã product</dt>
                    <dd class="col-sm-8">#@Model.Id</dd>
                    <dt class="col-sm-4">Danh mục</dt>
                    <dd class="col-sm-8">@Model.Category?.Name</dd>
                    <dt class="col-sm-4">Người đăng</dt>
                    <dd class="col-sm-8">@(Model.Owner?.UserName ?? "Admin/không rõ")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
