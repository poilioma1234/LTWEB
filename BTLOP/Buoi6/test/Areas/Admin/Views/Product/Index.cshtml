@model IEnumerable<test.Models.Product>

@{
    ViewData["Title"] = "Quản lý product";
    var products = Model.ToList();
}

<div class="bg-white rounded-3 shadow-sm p-3 mb-3">
    <div class="row g-3 align-items-center">
        <div class="col-lg">
            <span class="badge text-bg-danger mb-2">Admin</span>
            <h1 class="h3 fw-bold mb-1">Quản lý product</h1>
            <p class="text-secondary mb-0">Admin có thể xem, thêm, sửa, xem chi tiết và xóa mọi sản phẩm.</p>
        </div>
        <div class="col-lg-auto d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-danger">
                <i class="bi bi-plus-circle"></i>
                Thêm product
            </a>
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3 mb-3">
    <div class="col">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Tổng product</div>
                <div class="h3 fw-bold text-danger mb-0">@products.Count</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Có người đăng</div>
                <div class="h3 fw-bold text-danger mb-0">@products.Count(product => product.Owner != null)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Danh mục đang dùng</div>
                <div class="h3 fw-bold text-danger mb-0">@products.Select(product => product.CategoryId).Distinct().Count()</div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Product</th>
                <th>Giá</th>
                <th>Danh mục</th>
                <th>Người đăng</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in products)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="thumb" alt="@item.Name" />
                        }
                        <div>
                            <strong>@item.Name</strong>
                            <div class="small text-secondary">@item.Description</div>
                        </div>
                    </div>
                </td>
                <td class="fw-bold text-danger">@item.Price.ToString("N0")đ</td>
                <td><span class="badge text-bg-light">@item.Category?.Name</span></td>
                <td>@(item.Owner?.UserName ?? "Admin/không rõ")</td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-danger">
                            <i class="bi bi-pencil-square"></i>
                            Sửa
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                            Chi tiết
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i>
                            Xóa
                        </a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
