@model IEnumerable<test.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
    var products = Model.ToList();
    var categories = products
        .Where(product => product.Category != null)
        .GroupBy(product => product.Category!)
        .Select(group => group.Key)
        .Take(8)
        .ToList();
}

<section class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="swiper shop-hero rounded-3 overflow-hidden shadow-sm">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <img class="w-100" src="https://placehold.co/1200x430/d70018/ffffff?text=QLBanHang+-+Sale+dien+thoai" alt="Sale điện thoại QLBanHang" />
                </div>
                <div class="swiper-slide">
                    <img class="w-100" src="https://placehold.co/1200x430/111827/ffffff?text=Thu+cu+doi+moi+-+Gia+tot" alt="Thu cũ đổi mới" />
                </div>
                <div class="swiper-slide">
                    <img class="w-100" src="https://placehold.co/1200x430/0f766e/ffffff?text=Bao+hanh+1+doi+1+-+Ho+tro+tron+doi" alt="Bảo hành và hỗ trợ" />
                </div>
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="list-group shadow-sm">
            <a asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <i class="bi bi-lightning-charge-fill text-danger fs-3"></i>
                <span>
                    <strong class="d-block">Khuyến mãi hôm nay</strong>
                    <small class="text-secondary">Sản phẩm mẫu có giá tốt để demo.</small>
                </span>
            </a>
            <a asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <i class="bi bi-shield-check text-danger fs-3"></i>
                <span>
                    <strong class="d-block">Bảo hành rõ ràng</strong>
                    <small class="text-secondary">Thông tin sản phẩm và người đăng đầy đủ.</small>
                </span>
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <i class="bi bi-person-badge text-danger fs-3"></i>
                <span>
                    <strong class="d-block">Tài khoản demo</strong>
                    <small class="text-secondary">Admin/Member: 123456.</small>
                </span>
            </a>
        </div>
    </div>
</section>

<section class="row row-cols-2 row-cols-md-4 g-2 mb-4">
    <div class="col">
        <div class="alert alert-light border shadow-sm h-100 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-truck text-danger fs-4"></i>
            <span class="small fw-semibold">Giao nhanh toàn quốc</span>
        </div>
    </div>
    <div class="col">
        <div class="alert alert-light border shadow-sm h-100 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-arrow-repeat text-danger fs-4"></i>
            <span class="small fw-semibold">Đổi trả linh hoạt</span>
        </div>
    </div>
    <div class="col">
        <div class="alert alert-light border shadow-sm h-100 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-credit-card text-danger fs-4"></i>
            <span class="small fw-semibold">Thanh toán dễ dàng</span>
        </div>
    </div>
    <div class="col">
        <div class="alert alert-light border shadow-sm h-100 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-headset text-danger fs-4"></i>
            <span class="small fw-semibold">Hỗ trợ trọn đời</span>
        </div>
    </div>
</section>

@if (categories.Any())
{
    <section class="bg-white rounded-3 shadow-sm p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold mb-0">Danh mục nổi bật</h2>
            <a class="link-danger text-decoration-none small fw-semibold" asp-controller="Product" asp-action="Index">Xem tất cả</a>
        </div>
        <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-2">
            @foreach (var category in categories)
            {
                <div class="col">
                    <a class="btn btn-outline-secondary w-100 h-100 py-3" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id">
                        <i class="bi bi-phone d-block fs-4 text-danger mb-1"></i>
                        @category.Name
                    </a>
                </div>
            }
        </div>
    </section>
}

<section class="bg-white rounded-3 shadow-sm p-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <span class="badge text-bg-danger mb-2">Sản phẩm mẫu</span>
            <h1 class="h4 fw-bold mb-0">Điện thoại nổi bật</h1>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-danger btn-sm">Xem tất cả</a>
    </div>

    <div class="row row-cols-2 row-cols-lg-3 row-cols-xl-4 g-3">
        @foreach (var item in products)
        {
            var discount = 5 + item.Id % 12;
            <div class="col">
                <div class="card product-tile h-100 shadow-sm">
                    <div class="position-relative bg-light">
                        <span class="badge text-bg-danger position-absolute top-0 start-0 m-2">Giảm @discount%</span>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top product-image" alt="@item.Name" />
                        }
                    </div>
                    <div class="card-body d-flex flex-column gap-2">
                        <span class="badge text-bg-light align-self-start">@item.Category?.Name</span>
                        <h2 class="h6 card-title fw-bold mb-0">@item.Name</h2>
                        <p class="card-text small text-secondary mb-0">Bảo hành 1 đổi 1 trong 90 ngày. Hỗ trợ phần mềm trọn đời máy.</p>
                        <div class="mt-auto">
                            <div class="text-danger fw-bold">@item.Price.ToString("N0")đ</div>
                            <div class="small text-secondary text-decoration-line-through">@((item.Price * 1.12m).ToString("N0"))đ</div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-danger w-100">
                            <i class="bi bi-eye"></i>
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
