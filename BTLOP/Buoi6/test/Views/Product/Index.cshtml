@model IEnumerable<test.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm";
    var products = Model.ToList();
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="bg-white rounded-3 shadow-sm p-3 mb-3">
    <div class="row g-3 align-items-center">
        <div class="col-lg">
            <span class="badge text-bg-danger mb-2">QLBanHang</span>
            <h1 class="h3 fw-bold mb-1">Sản phẩm</h1>
            <p class="text-secondary mb-0">Xem sản phẩm theo danh mục, tìm kiếm theo tên hoặc mở chi tiết sản phẩm.</p>
        </div>
        @if (User.IsInRole("Member"))
        {
            <div class="col-lg-auto">
                <a asp-action="MyProducts" class="btn btn-danger">
                    <i class="bi bi-shop"></i>
                    Sản phẩm của tôi
                </a>
            </div>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="bg-white rounded-3 shadow-sm p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-lg-5">
            <label class="form-label fw-semibold" for="q">Tìm kiếm</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-danger"></i></span>
                <input id="q" name="q" value="@searchTerm" class="form-control" placeholder="Nhập tên sản phẩm..." />
            </div>
        </div>
        <div class="col-lg-4">
            <label class="form-label fw-semibold" for="categoryId">Danh mục</label>
            <select id="categoryId" name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">Tất cả danh mục</option>
            </select>
        </div>
        <div class="col-lg-auto d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-funnel"></i>
                Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a>
        </div>
    </div>
</form>

<section class="bg-white rounded-3 shadow-sm p-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold mb-0">@products.Count sản phẩm</h2>
        <span class="small text-secondary">Giá và khuyến mãi demo theo dữ liệu mẫu</span>
    </div>

    @if (!products.Any())
    {
        <div class="alert alert-light border text-center py-5 mb-0">
            <i class="bi bi-search display-5 text-danger"></i>
            <h3 class="h5 mt-3">Không tìm thấy sản phẩm</h3>
            <p class="text-secondary mb-0">Bạn thử đổi từ khóa hoặc chọn danh mục khác.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-lg-3 row-cols-xl-4 g-3">
            @foreach (var item in products)
            {
                var discount = 5 + item.Id % 12;
                <div class="col">
                    <div class="card product-tile h-100 shadow-sm">
                        <div class="position-relative bg-light">
                            <span class="badge text-bg-danger position-absolute top-0 start-0 m-2">Giảm @discount%</span>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top product-image" alt="@item.Name" />
                            }
                        </div>
                        <div class="card-body d-flex flex-column gap-2">
                            <span class="badge text-bg-light align-self-start">@item.Category?.Name</span>
                            <h2 class="h6 card-title fw-bold mb-0">@item.Name</h2>
                            <p class="card-text small text-secondary mb-0">Bảo hành 1 đổi 1 trong 90 ngày. Hỗ trợ phần mềm trọn đời máy.</p>
                            <div class="mt-auto">
                                <div class="text-danger fw-bold">@item.Price.ToString("N0")đ</div>
                                <div class="small text-secondary text-decoration-line-through">@((item.Price * 1.12m).ToString("N0"))đ</div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0 d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-danger">
                                <i class="bi bi-eye"></i>
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
