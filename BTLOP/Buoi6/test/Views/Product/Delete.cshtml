@model test.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h1>Xóa sản phẩm</h1>
<div class="alert alert-warning">Bạn có chắc chắn muốn xóa sản phẩm này khỏi gian hàng của mình?</div>

<div class="surface col-lg-7">
    <div class="d-flex gap-3">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="thumb-large" alt="@Model.Name" />
        }
        <div>
            <h2 class="h4">@Model.Name</h2>
            <p class="text-muted">@Model.Category?.Name</p>
            <p class="fw-bold">@Model.Price.ToString("N0") đ</p>
        </div>
    </div>
    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="MyProducts" class="btn btn-secondary">Trở lại</a>
    </form>
</div>
