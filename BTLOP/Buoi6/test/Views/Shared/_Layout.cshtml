@using test.Repository
@inject ICategoryRepository CategoryRepository

@{
    var layoutCategories = (await CategoryRepository.GetAllAsync()).Take(8).ToList();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLBanHang</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/test.styles.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-danger py-2">
            <div class="container gap-2">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-phone"></i>
                    QLBanHang
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse gap-3" id="mainNavbar">
                    <form class="flex-grow-1" asp-area="" asp-controller="Product" asp-action="Index" method="get">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-0"><i class="bi bi-search text-danger"></i></span>
                            <input class="form-control border-0" type="search" name="q" value="@ViewBag.SearchTerm" placeholder="Bạn cần tìm sản phẩm nào?" />
                            <button class="btn btn-light fw-semibold text-danger" type="submit">Tìm</button>
                        </div>
                    </form>

                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link text-white d-flex align-items-center gap-1" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap"></i>
                                Sản phẩm
                            </a>
                        </li>
                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white d-flex align-items-center gap-1" asp-area="" asp-controller="Product" asp-action="MyProducts">
                                    <i class="bi bi-shop"></i>
                                    Gian hàng
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-speedometer2"></i>
                                    Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Index">Quản lý product</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index">Quản lý category</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">Quản lý user</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-white d-flex align-items-center gap-1" href="#">
                                <i class="bi bi-cart3"></i>
                                Giỏ hàng
                            </a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>

        <div class="bg-white border-bottom">
            <div class="container">
                <div class="d-flex align-items-center gap-2 py-2 overflow-auto text-nowrap">
                    <a class="btn btn-danger btn-sm fw-semibold" asp-area="" asp-controller="Product" asp-action="Index">
                        <i class="bi bi-list"></i>
                        Danh mục
                    </a>
                    @foreach (var category in layoutCategories)
                    {
                        <a class="btn btn-outline-secondary btn-sm rounded-pill" asp-area="" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id">
                            @category.Name
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="container py-3 py-lg-4">
        @RenderBody()
    </main>

    <footer class="bg-white border-top mt-4">
        <div class="container py-4">
            <div class="row g-3 align-items-center">
                <div class="col-md">
                    <strong>QLBanHang</strong>
                    <div class="text-secondary small">Website thương mại điện tử ASP.NET Core MVC dùng Bootstrap, Identity và phân quyền.</div>
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <span class="badge text-bg-danger">Admin</span>
                    <span class="badge text-bg-secondary">Member</span>
                    <span class="badge text-bg-light">QLBanHang</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
