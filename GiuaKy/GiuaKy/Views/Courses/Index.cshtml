@model IEnumerable<GiuaKy.Models.Course>

@{
    ViewData["Title"] = "Quản lý học phần";
}

<div class="d-flex flex-column gap-3">
    <div class="d-flex justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h3 mb-1">Quản lý học phần</h1>
            <p class="text-muted mb-0">Thêm, sửa và xóa học phần trong hệ thống.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Thêm học phần</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th style="width: 120px;">Hình ảnh</th>
                    <th>Tên học phần</th>
                    <th style="width: 110px;">Số tín chỉ</th>
                    <th>Giảng viên</th>
                    <th>Danh mục</th>
                    <th style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td>
                            <img src="@course.Image" alt="@course.Name" class="rounded" style="width: 96px; height: 64px; object-fit: cover;" />
                        </td>
                        <td>@course.Name</td>
                        <td>@course.Credits</td>
                        <td>@course.Lecturer</td>
                        <td>@course.Category?.Name</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
