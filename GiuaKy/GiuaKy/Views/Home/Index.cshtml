@model GiuaKy.Models.CourseListViewModel

@{
    ViewData["Title"] = Model.Title;
    var isStudent = User.IsInRole("Student");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.bootstrap5.min.css" />
    <style>
        #coursesTable {
            table-layout: fixed;
        }

        .course-image {
            width: 96px;
            height: 64px;
            object-fit: cover;
        }

        .course-image-column {
            width: 130px;
        }

        .course-credits-column {
            width: 120px;
        }

        .course-action-column {
            width: 150px;
        }
    </style>
}

<div class="d-flex flex-column gap-4">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">Danh sách học phần đang mở trong học kỳ này.</p>
    </div>

    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label for="search" class="form-label">Tìm kiếm học phần</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Nhập tên học phần" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>
        <div class="col-auto">
            <a href="@Context.Request.Path" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </form>

    <div class="table-responsive">
        <table id="coursesTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th class="course-image-column">Hình ảnh</th>
                    <th>Tên học phần</th>
                    <th class="course-credits-column">Số tín chỉ</th>
                    <th>Giảng viên</th>
                    @if (isStudent)
                    {
                        <th class="course-action-column">Đăng ký</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td>
                            <img src="@course.Image"
                                 class="course-image rounded"
                                 alt="@course.Name" />
                        </td>
                        <td>@course.Name</td>
                        <td>@course.Credits</td>
                        <td>@course.Lecturer</td>
                        @if (isStudent)
                        {
                            <td>
                                @if (Model.EnrolledCourseIds.Contains(course.Id))
                                {
                                    <form asp-controller="Enroll" asp-action="Cancel" asp-route-courseId="@course.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đăng ký</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Enroll" asp-action="Enroll" asp-route-courseId="@course.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-success">Enroll</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        new DataTable('#coursesTable', {
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            searching: false,
            columnDefs: [
                { targets: 0, orderable: false, searchable: false }
                @if (isStudent)
                {
                    <text>, { targets: 4, orderable: false, searchable: false }</text>
                }
            ],
            language: {
                lengthMenu: 'Hiển thị _MENU_ học phần',
                info: 'Hiển thị _START_ đến _END_ trong tổng số _TOTAL_ học phần',
                infoEmpty: 'Không có học phần nào',
                zeroRecords: 'Không tìm thấy học phần phù hợp',
                paginate: {
                    first: 'Đầu',
                    last: 'Cuối',
                    next: 'Sau',
                    previous: 'Trước'
                }
            }
        });
    </script>
}
