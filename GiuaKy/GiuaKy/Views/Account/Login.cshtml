@using Microsoft.AspNetCore.Authentication
@model GiuaKy.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    var externalLogins = ViewBag.ExternalLogins as List<AuthenticationScheme> ?? new List<AuthenticationScheme>();
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Đăng nhập</h1>

        @if (TempData["LoginError"] != null)
        {
            <div class="alert alert-danger">@TempData["LoginError"]</div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UsernameOrEmail" class="form-label"></label>
                <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" />
                <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        </form>

        <div class="mt-3">
            <a asp-action="Register">Chưa có tài khoản? Đăng ký</a>
        </div>

        @if (externalLogins.Any())
        {
            <hr />
            <form asp-action="ExternalLogin" method="post">
                @foreach (var provider in externalLogins)
                {
                    <button type="submit" name="provider" value="@provider.Name" class="btn btn-outline-danger w-100">
                        Login with @provider.DisplayName
                    </button>
                }
            </form>
        }
        else
        {
            <div class="alert alert-secondary mt-3 mb-0">
                Google Login chưa được cấu hình ClientId và ClientSecret.
            </div>
        }
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
