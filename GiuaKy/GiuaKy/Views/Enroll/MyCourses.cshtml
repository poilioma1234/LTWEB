@model IEnumerable<GiuaKy.Models.Enrollment>

@{
    ViewData["Title"] = "Học phần của tôi";
}

<div class="d-flex flex-column gap-3">
    <div>
        <h1 class="h3 mb-1">Học phần của tôi</h1>
        <p class="text-muted mb-0">Danh sách học phần bạn đã đăng ký.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa đăng ký học phần nào.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Học phần</th>
                        <th>Số tín chỉ</th>
                        <th>Giảng viên</th>
                        <th>Ngày đăng ký</th>
                        <th style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in Model)
                    {
                        <tr>
                            <td>@enrollment.Course?.Name</td>
                            <td>@enrollment.Course?.Credits</td>
                            <td>@enrollment.Course?.Lecturer</td>
                            <td>@enrollment.EnrollDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <form asp-action="Cancel" asp-route-courseId="@enrollment.CourseId" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đăng ký</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
